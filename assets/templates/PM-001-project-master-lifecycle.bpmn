    <bpmn:sequenceFlow id="Flow_07" sourceRef="Activity_ArchitectureReview" targetRef="Activity_Roadmap"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Activity_Roadmap" targetRef="Activity_RoadmapReview"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Activity_RoadmapReview" targetRef="Activity_RecoverContext"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_RecoverContext" targetRef="Activity_SelectComponent"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_SelectComponent" targetRef="Activity_LoadContract"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_LoadContract" targetRef="Activity_Implement"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_Implement" targetRef="Activity_Test"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Activity_Test" targetRef="Activity_VerifyRequirements"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Activity_VerifyRequirements" targetRef="Activity_VerifyBPMN"/>
    <bpmn:sequenceFlow id="Flow_15a" sourceRef="Activity_VerifyBPMN" targetRef="Activity_Review"/>
    <bpmn:sequenceFlow id="Flow_15b" sourceRef="Activity_Review" targetRef="Activity_PersistState"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_PersistState" targetRef="Gateway_ComponentAccepted"/>
    <bpmn:sequenceFlow id="Flow_17a" name="Нет" sourceRef="Gateway_ComponentAccepted" targetRef="Activity_Diagnose"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Activity_Diagnose" targetRef="Activity_Implement"/>
    <bpmn:sequenceFlow id="Flow_18" name="Да" sourceRef="Gateway_ComponentAccepted" targetRef="Activity_Checkpoint"/>
    <bpmn:sequenceFlow id="Flow_18a" sourceRef="Activity_Checkpoint" targetRef="Gateway_MoreComponents"/>
    <bpmn:sequenceFlow id="Flow_19" name="Да" sourceRef="Gateway_MoreComponents" targetRef="Activity_SelectComponent"/>
    <bpmn:sequenceFlow id="Flow_20" name="Нет" sourceRef="Gateway_MoreComponents" targetRef="Activity_PhaseVerification"/>
    <bpmn:sequenceFlow id="Flow_20a" sourceRef="Activity_PhaseVerification" targetRef="Gateway_MorePhases"/>
    <bpmn:sequenceFlow id="Flow_21" name="Да" sourceRef="Gateway_MorePhases" targetRef="Activity_RecoverContext"/>
    <bpmn:sequenceFlow id="Flow_22" name="Нет" sourceRef="Gateway_MorePhases" targetRef="Activity_Verification"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Activity_Verification" targetRef="Activity_CompletionReview"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Activity_CompletionReview" targetRef="Event_Complete"/>
  </bpmn:process>
